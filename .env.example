# Copy this file to .env (which Git ignores) and fill in your values.
# Never commit a real key.
# Default provider is Groq (free, no card): https://console.groq.com/keys
LLM_API_KEY=paste-your-key-here
LLM_MODEL=run-python-m-src.llm-and-pick-a-model-id
# Only needed for a provider other than Groq, for example
# https://openrouter.ai/api/v1
# LLM_BASE_URL=
